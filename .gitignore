# Dependencies
node_modules/

# Environment & secrets
.env
**/.env
.env.local
.env.*.local
*.pem
**/firebase-adminsdk*.json
Backend/Admin_Backend/secrets/
# Automated daily ops report JSON snapshots (set DAILY_OPS_REPORT_SNAPSHOT_DIR)
Backend/Admin_Backend/data/daily-ops-snapshots/
Backend/Admin_Backend/data/app-downloads/*
# ...except the one APK Render actually needs to serve GET /api/download/attendant-app from — a
# committed file is part of each deploy's checkout, so it isn't subject to Render's ephemeral-disk
# wipe on every redeploy, unlike a file placed there by hand after the fact. (Directory-level
# excludes must be flattened to a /* pattern first, since gitignore cannot re-include a file
# inside an excluded directory otherwise — see gitignore(5).)
!Backend/Admin_Backend/data/app-downloads/attendant-app-latest.apk

# Logs & OS
logs/
*.log
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
.next/
out/
coverage/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# LilyGO / firmware local secrets (copy from config.h.example)
hardware/**/config.h

# Misc
*.swp
*.swo
